PORT=8000
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Public URL used in password-reset links
APP_URL=http://localhost:8000

# Resend HTTPS email delivery
# Create a Resend API key and verify the sending domain/address first.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=HotelEase <noreply@your-domain.com>

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
